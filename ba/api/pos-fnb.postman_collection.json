            "api",
            "v1",
            "shifts",
            "open"
          ]
        },
        "description": "Mở ca làm việc mới và ghi nhận tiền lẻ đầu ca trong két · FR-06",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{token}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
